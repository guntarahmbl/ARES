# Route advisor (optional). Copy this file to .env and set ONE key.
# Every provider below has a free tier; without a key the advisor stays off
# and the rest of ARES Path works as before.

# Google Gemini - key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Groq - key from https://console.groq.com/keys
# GROQ_API_KEY=

# OpenRouter (models ending in ":free") - key from https://openrouter.ai/keys
# OPENROUTER_API_KEY=

# Local model through Ollama, no key and nothing leaves the machine:
# ARES_LLM_PROVIDER=ollama

# Optional overrides. Free model line-ups change; set the model your account lists.
# ARES_LLM_PROVIDER=gemini
# ARES_LLM_MODEL=gemini-3.5-flash
# ARES_LLM_BASE_URL=
# ARES_LLM_API_KEY=
