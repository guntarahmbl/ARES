# ARES Mission Analyst is optional and disabled by default.
# Start 9Router locally, create the ares-mission-analyst combo, then enable it.
ARES_LLM_ENABLED=false
NINEROUTER_BASE_URL=http://127.0.0.1:20128/v1
NINEROUTER_MODEL=ares-mission-analyst

# Only set this when the local 9Router instance requires bearer authentication.
NINEROUTER_API_KEY=
